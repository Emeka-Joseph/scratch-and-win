# Copy to .env in the application root on the server and fill in every value.
# The app refuses to start in production with a weak SECRET_KEY, a SQLite database or a non-https URL.

FLASK_ENV=production
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Your live https address, scheme + domain only (no trailing slash, no sub-path).
# It is printed into every QR code and email, so set it before printing posters.
PUBLIC_BASE_URL=https://promo.example.com
APP_TIMEZONE=Asia/Riyadh
GROUP_NAME=Razzmattazz Hospitality Group
# 1 only if Cloudflare or another proxy sits in front of the server
TRUST_PROXY=0

# cPanel prefixes database and user names with your account name, e.g. cpuser_promo
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=mysql+pymysql://CPUSER_dbuser:PASSWORD@localhost:3306/CPUSER_promo?charset=utf8mb4

# Used once by deploy/bootstrap.py, then change the password from the app.
SUPERADMIN_EMAIL=admin@razzmattazz.com
SUPERADMIN_PASSWORD=

MAIL_PROVIDER=smtp
# cPanel mailbox: mail.yourdomain.com, port 465 SSL (or 587 TLS). Gmail: smtp.gmail.com 587 + app password.
MAIL_SERVER=mail.example.com
MAIL_PORT=465
MAIL_USE_TLS=0
MAIL_USE_SSL=1
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Razzmattazz Hospitality Group
MAIL_SUPPRESS_SEND=0
