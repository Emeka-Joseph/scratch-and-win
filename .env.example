# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
# Public base URL used inside QR codes and emails (no trailing slash).
# Use your LAN IP (e.g. http://192.168.1.20:5000) so phones can open the links during testing.
PUBLIC_BASE_URL=http://127.0.0.1:9800
PORT=9800
APP_TIMEZONE=Asia/Riyadh
GROUP_NAME=Razzmattazz Hospitality Group

# ---- Database (MySQL) ----
# mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4
# Leave empty to fall back to a local SQLite file (development only).
DATABASE_URL=

# ---- Superadmin bootstrap (used by `flask create-superadmin`) ----
SUPERADMIN_EMAIL=admin@razzmattazz.com
SUPERADMIN_PASSWORD=ChangeMe!2026

# ---- Mail ----
MAIL_PROVIDER=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Razzmattazz Hospitality Group
# Set to 1 to print emails to the console instead of sending them
MAIL_SUPPRESS_SEND=0
